{
  "readme": [
    "这是模板文件，可安全提交到 git。真实密钥请勿写在此处。",
    "覆盖顺序：内置默认值 → config.example.json → config.local.json（git 忽略）→ 环境变量 / .env。",
    "密钥只允许来自环境变量或 .env：OPENAI_API_KEY、OPENAI_MODEL、OPENAI_BASE_URL。",
    "dataguidance.url 与 podcast.rss_url 默认为空：PRD 未提供，后端不会推测地址，留空即返回 not_configured。",
    "dataguidance.selectors 全部需要在真实页面确认后再填写；本仓库中的选择器从未在真实站点验证过。",
    "official.domains 为权威来源域名白名单，可按需增删；不在白名单内的出站链接不会被当作官方来源。",
    "human_verified 用于人工核验登记：{ \"<event_id>\": { \"verified_at\": \"YYYY-MM-DD\", \"note\": \"...\" } }，只有登记过才会出现 verification_status=verified。"
  ],
  "server": {
    "host": "127.0.0.1",
    "port": 8765,
    "api_token_header": "X-Radar-Request",
    "api_token_value": "1"
  },
  "privacy": {
    "max_quote_chars": 300,
    "max_fact_chars": 600,
    "max_summary_chars": 400
  },
  "schedule": {
    "label": "每周一 09:00 · 北京时间",
    "engine": "WorkBuddy / GitHub Actions 待部署"
  },
  "dataguidance": {
    "name": "DataGuidance",
    "url": "",
    "engine": "playwright",
    "max_pages": 20,
    "timeout_ms": 45000,
    "count_regex": "共\\s*([0-9][0-9,]{0,9})\\s*条",
    "selectors": {
      "all_tab": "",
      "expected_count": "",
      "item": "",
      "item_title": "",
      "item_link": "",
      "item_date": "",
      "item_authority": "",
      "item_jurisdiction": "",
      "item_type": "",
      "item_category": "",
      "next_page": ""
    }
  },
  "wechat": {
    "name": "微信公众号",
    "links_file": "data/wechat_links.txt",
    "request_timeout": 20,
    "max_items": 50,
    "use_playwright_fallback": true,
    "playwright_timeout_ms": 30000,
    "min_delay_seconds": 1.5
  },
  "podcast": {
    "name": "播客 · 那一片数据星辰",
    "rss_url": "",
    "past_days": 7,
    "max_items": 30,
    "request_timeout": 20
  },
  "official": {
    "max_links_per_event": 3,
    "request_timeout": 15,
    "fetch_pages": true,
    "prefer_keywords": [
      "公告",
      "条例",
      "办法",
      "规定",
      "指引",
      "指南",
      "通知",
      "regulation",
      "guidance",
      "notice"
    ],
    "domains": [
      "gov.cn",
      "npc.gov.cn",
      "cac.gov.cn",
      "miit.gov.cn",
      "mofcom.gov.cn",
      "samr.gov.cn",
      "csrc.gov.cn",
      "nfra.gov.cn",
      "tc260.org.cn",
      "europa.eu",
      "eur-lex.europa.eu",
      "edpb.europa.eu",
      "ec.europa.eu",
      "ftc.gov",
      "congress.gov",
      "federalregister.gov",
      "nist.gov",
      "sec.gov",
      "leginfo.legislature.ca.gov",
      "cppa.ca.gov",
      "oag.ca.gov",
      "ppc.go.jp",
      "meti.go.jp",
      "cao.go.jp",
      "pipc.go.kr",
      "msit.go.kr"
    ]
  },
  "ai": {
    "base_url": "https://api.openai.com/v1",
    "model": "",
    "timeout": 90,
    "max_events_per_request": 20,
    "max_input_chars": 1500,
    "temperature": 0
  },
  "human_verified": {}
}
